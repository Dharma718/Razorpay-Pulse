PORT=5000

# How often (ms) the simulation advances one "tick" (one simulated minute of traffic)
TICK_INTERVAL_MS=2500

# Optional: get a free key from https://aistudio.google.com/app/apikey
# Used ONLY to turn structured evidence into a natural-language narrative and
# customer notices. Never used to decide the diagnosis, confidence, or action.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Signs session cookies. Set this to any long random string for persistent
# sessions across server restarts — if left blank, a random one is generated
# each time the server starts, which means everyone gets signed out on restart.
SESSION_SECRET=
